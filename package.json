{
  "name": "shotsweep",
  "version": "0.1.2",
  "description": "Capture every screen of your web app in one command and bundle it for AI review. Finds routes, closes popups, handles login, compresses images.",
  "type": "module",
  "bin": {
    "shotsweep": "dist/cli.js"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc",
    "start": "node dist/cli.js",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "screenshot",
    "playwright",
    "ui-review",
    "ai",
    "llm",
    "chatgpt",
    "claude",
    "visual-qa",
    "cli",
    "web-app"
  ],
  "author": "DHANUSH",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dhanush-VibeCoder/shotsweep.git"
  },
  "bugs": {
    "url": "https://github.com/Dhanush-VibeCoder/shotsweep/issues"
  },
  "homepage": "https://github.com/Dhanush-VibeCoder/shotsweep#readme",
  "dependencies": {
    "commander": "^12.1.0",
    "jszip": "^3.10.2",
    "playwright": "^1.51.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
